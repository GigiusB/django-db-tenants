# Local environment. Copy to .env (git-ignored) and adjust.
# The test suite reads the TEST_* variables from .env itself; the rest only take
# effect when .env is exported into your shell (direnv with .envrc.example).
# The TEST_* defaults match the services in docker-compose.yml.
#
# tox sets TEST_DB from the env name (py313-dj52-pg -> pg); set it here only
# to choose the backend for plain `pytest` runs: sqlite (default), pg or mysql.
# TEST_DB=sqlite
#
# The accounts must be allowed to CREATE and DROP databases: the suite creates
# test_<NAME> (test_<NAME>_<tox env> under tox, e.g. test_django_db_tenants_py313_dj52_pg)
# plus one test_tenant_* database per tenant, and drops them afterwards.

# PostgreSQL >= 15 covers the whole matrix (Django 4.2: 12+, 5.2/6.0: 14+, 6.1: 15+)
TEST_PG_HOST=127.0.0.1
TEST_PG_PORT=55432
TEST_PG_USER=tenants
TEST_PG_PASSWORD=tenants
TEST_PG_NAME=django_db_tenants

# MySQL >= 8.4 covers the whole matrix (Django 4.2-6.0: 8.0.11+, 6.1: 8.4+)
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=53306
TEST_MYSQL_USER=root
TEST_MYSQL_PASSWORD=tenants
TEST_MYSQL_NAME=django_db_tenants

# Demo project (tests/demo). Optional: the defaults in demo/settings.py work as is.
# Ignored by the test suite, which uses its own settings.
# Keep comments on their own lines: values are read up to the end of the line.
#
# Directory of the demo's SQLite files (shared and tenant databases); absolute path.
# Default: tests/demo/var
# DEMO_VAR_DIR=/tmp/django-db-tenants-demo
# DJANGO_SECRET_KEY=change-me
# 1 = debug on, anything else = off. Default: 1
# DJANGO_DEBUG=1
# Fernet key for the demo's stored secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Tooling. Optional.
# Silences uv's "Failed to hardlink files" warning when its cache is on another filesystem.
# UV_LINK_MODE=copy
